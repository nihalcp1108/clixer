# ==============================================================================
# Clixer / SACO Trading Company — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ------------------------------------------------------------------------------
# URL of your deployed Railway Express backend (with or without /api)
VITE_API_URL=https://your-backend.up.railway.app/api

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Railway)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/clixer?retryWrites=true&w=majority

# JWT authentication secret for admin sessions
JWT_SECRET=your_jwt_secret_key_here

# Initial / Fallback Admin credentials
ADMIN_EMAIL=clixer@admin.com
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password_here

# Frontend origin(s) allowed by CORS (comma-separated or single URL)
CLIENT_URL=https://clixer.in,https://www.clixer.in,https://your-app.vercel.app

# Cloudinary image hosting credentials (optional, falls back to disk storage if omitted)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
